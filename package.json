{
  "name": "yaaiop",
  "version": "1.0.0",
  "description": "Yet Another AI Obsidian Plugin — vault-aware AI chat for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "llm",
    "anthropic",
    "claude",
    "openai",
    "gpt",
    "gemini",
    "openrouter"
  ],
  "author": "Nicolas Sassi",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.15.0",
    "openai": "^7.4.0"
  }
}
